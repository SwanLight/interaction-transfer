# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
venv/
.venv/

# 训练产物 —— 一律不进仓库，体积大且可重跑
outputs/
logs/
runs/
checkpoints/
*.pt
*.pth
*.ckpt
wandb/

# 评估产物
videos/
*.mp4
report*.html
eval_results/

# 数据集 —— Oracle Interaction Record 按 plan/03 §6 是 GB 量级
data/
datasets/
*.hdf5
*.npz
*.zarr

# Isaac 资产（由 tools/fetch_assets.py 重新拉取，不进仓库）
assets/
*.usd
*.usda
*.usdc

# 系统
.DS_Store
*.swp
.idea/
.vscode/

# S0~S4 产出。⚠️ **只排除能重新生成的二进制**（录像 / 热图 png / HTML 报告），
# `out/**/README.md` 与各类 txt 摘要**要进版本控制**：D-23 的原意是排除
# checkpoint、视频、数据集、Isaac 资产，不是排除文档；而那些 README 是手写的、
# 没有任何脚本能重新生成，掉了就没了。P-56 讲的正是"数字没有产物就会悄悄过期"，
# 把唯一记着这些数的文件排除在版本控制外，是同一个病。
out/**/*.mp4
out/**/*.png
out/**/*.html
out/*.mp4
out/*.png
out/*.html

# S5 本地 smoke 下载的真实 S4 输入（服务器数据的临时子集，不是项目产物）
out/s5_smoke_inputs/

.git_sha
